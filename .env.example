# Для локального запуска можно оставить SQLite и не создавать .env
# Для PostgreSQL раскомментируйте и заполните:
# DB_ENGINE=postgresql
# DB_NAME=agromarket_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
ADMIN_EMAIL=
DEFAULT_FROM_EMAIL=site@agromarket.local
